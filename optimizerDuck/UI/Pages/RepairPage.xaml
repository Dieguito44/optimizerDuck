<Page
    x:Class="optimizerDuck.UI.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RepairPage"
    d:DataContext="{d:DesignInstance local:RepairPage}"
    d:DesignHeight="800"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Style="{StaticResource PageHeaderStyle}">
            <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Repair.Header.Title}" />
            <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Repair.Header.Description}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{ext:Loc Repair.Warning}"
                    Severity="Warning" />

                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Repair.Steps.Title}" />
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Repair.Steps.Description}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarSurfaceStyle}">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ViewModel.RunRepairCommand}"
                        Content="{ext:Loc Repair.Button.Run}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                </Border>

                <StackPanel Visibility="{Binding ViewModel.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock
                        Margin="0,8,0,8"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{ext:Loc Repair.Results.Title}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSurfaceStyle}">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <ui:TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Text="{Binding Outcome}" />
                                        </Grid>
                                        <ui:TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding Summary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

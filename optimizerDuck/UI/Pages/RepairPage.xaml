<Page
    x:Class="optimizerDuck.UI.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RepairPage"
    d:DataContext="{d:DesignInstance local:RepairPage}"
    d:DesignHeight="800"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource PageHeaderGridStyle}">
            <Border Style="{StaticResource PageIconTileStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="WrenchScrewdriver24" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Repair.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Repair.Header.Description}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{ext:Loc Repair.Warning}"
                    Severity="Warning" />

                <!--  Redesign (19/11/2026): one card per tool, with its status and an "Ejecutar" button.  -->
                <WrapPanel Margin="0,0,-12,0" ItemWidth="380" Orientation="Horizontal">
                    <Border
                        Margin="0,0,12,12"
                        Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ui:SymbolIcon
                                        FontSize="19"
                                        Foreground="{DynamicResource ZentraBrandBrush}"
                                        Symbol="WrenchScrewdriver24" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Repair.Button.Run}" TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,3,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{ext:Loc Repair.Steps.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                ColumnDefinitions="*,Auto">
                                <Border HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                    <TextBlock FontSize="12" Text="{Binding ViewModel.RepairState.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.RepairState.Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraBrandBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.RepairState.Status}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraGoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.RepairState.Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.RunRepairCommand}"
                                    Content="{ext:Loc Tool.Run}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon Play24}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,0,12,12"
                        Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ui:SymbolIcon
                                        FontSize="19"
                                        Foreground="{DynamicResource ZentraBrandBrush}"
                                        Symbol="ShieldCheckmark24" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Defender.Full.Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,3,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{ext:Loc Tool.Defender.Full.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                ColumnDefinitions="*,Auto">
                                <Border HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                    <TextBlock FontSize="12" Text="{Binding ViewModel.FullScanState.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.FullScanState.Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraBrandBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.FullScanState.Status}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraGoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.FullScanState.Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.FullScanCommand}"
                                    Content="{ext:Loc Tool.Run}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon Play24}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,0,12,12"
                        Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ui:SymbolIcon
                                        FontSize="19"
                                        Foreground="{DynamicResource ZentraBrandBrush}"
                                        Symbol="ArrowRepeatAll24" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Defender.Offline.Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,3,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{ext:Loc Tool.Defender.Offline.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                ColumnDefinitions="*,Auto">
                                <Border HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                    <TextBlock FontSize="12" Text="{Binding ViewModel.OfflineScanState.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.OfflineScanState.Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraBrandBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.OfflineScanState.Status}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraGoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.OfflineScanState.Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.OfflineScanCommand}"
                                    Content="{ext:Loc Tool.Run}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon Play24}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,0,12,12"
                        Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ui:SymbolIcon
                                        FontSize="19"
                                        Foreground="{DynamicResource ZentraBrandBrush}"
                                        Symbol="ShieldQuestion24" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc SafetyScanner.Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,3,0,0"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{ext:Loc Tool.SafetyScanner.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                ColumnDefinitions="*,Auto">
                                <Border HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                    <TextBlock FontSize="12" Text="{Binding ViewModel.SafetyScanState.Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.SafetyScanState.Status}" Value="Running">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraBrandBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.SafetyScanState.Status}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraGoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ViewModel.SafetyScanState.Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ZentraCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.SafetyScanCommand}"
                                    Content="{ext:Loc Tool.Run}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon Play24}" />
                            </Grid>
                        </Grid>
                    </Border>
                </WrapPanel>

                <StackPanel Visibility="{Binding ViewModel.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock
                        Margin="0,8,0,8"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{ext:Loc Repair.Results.Title}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSurfaceStyle}">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <ui:TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Text="{Binding Outcome}" />
                                        </Grid>
                                        <ui:TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding Summary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

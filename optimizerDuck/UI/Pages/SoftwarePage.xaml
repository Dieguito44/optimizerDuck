<Page
    x:Class="optimizerDuck.UI.Pages.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Title="SoftwarePage"
    d:DataContext="{d:DesignInstance local:SoftwarePage}"
    d:DesignHeight="800"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource PageHeaderGridStyle}">
            <Border Style="{StaticResource PageIconTileStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="AppsAddIn24" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Software.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Software.Header.Description}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource ToolbarSurfaceStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding ViewModel.RefreshCommand}"
                            Content="{ext:Loc Software.Button.Refresh}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ViewModel.UpgradeAllCommand}"
                            Content="{ext:Loc Software.Button.UpgradeAll}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="12,0,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ViewModel.StatusText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Redesign (19/11/2026): one card per program, status and buttons at the bottom.  -->
                <ItemsControl Margin="0,0,-12,0" ItemsSource="{Binding ViewModel.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="420" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,12,12"
                                Padding="16,14"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Style="{StaticResource CardIconTileStyle}">
                                            <ui:SymbolIcon Style="{StaticResource CardIconStyle}" Symbol="AppsAddIn24" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Description}" />
                                            <ui:TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Details}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid
                                        Grid.Row="2"
                                        Margin="0,12,0,0"
                                        ColumnDefinitions="*,Auto">
                                        <Border HorizontalAlignment="Left" Style="{StaticResource StatusChipStyle}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Appearance="Primary"
                                                Command="{Binding DataContext.ViewModel.InstallCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Content="{ext:Loc Software.Button.Install}"
                                                Cursor="Hand"
                                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.UninstallCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Content="{ext:Loc Software.Button.Uninstall}"
                                                Cursor="Hand"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Software.Drivers.Title}" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            Text="{ext:Loc Software.Drivers.Description}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ViewModel.DriverPages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Margin="0,2,0,2"
                                        Command="{Binding DataContext.ViewModel.OpenDriverPageCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"
                                        Cursor="Hand"
                                        Icon="{ui:SymbolIcon Open24}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

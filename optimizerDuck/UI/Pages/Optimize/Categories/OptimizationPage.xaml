<Page
    x:Class="optimizerDuck.UI.Pages.Optimizations.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:optimization="clr-namespace:optimizerDuck.Domain.Optimizations.Models"
    xmlns:optimizations="clr-namespace:optimizerDuck.UI.Pages.Optimizations"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="OptimizationPage"
    d:DataContext="{d:DesignInstance optimizations:OptimizationPage}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid>
        <!--  Main Content  -->
        <Grid RowDefinitions="Auto,*" Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <!--  Toolbar  -->
            <Border Grid.Row="0" Style="{StaticResource ToolbarSurfaceStyle}">
                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  Search  -->
                    <ui:TextBox
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{ext:Loc Common.Search.Placeholder}"
                        Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Filter by Risk  -->
                    <ComboBox
                        SelectedIndex="{Binding ViewModel.SelectedRiskFilterIndex}"
                        ToolTip="{ext:Loc Common.Filter}"
                        ToolTipService.BetweenShowDelay="160"
                        ToolTipService.Placement="Top">
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="Filter24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.Filter.All}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Symbol="ShieldCheckmark24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Safe}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="Warning24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Moderate}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Symbol="ShieldError24" />
                                <TextBlock Grid.Column="1" Text="{ext:Loc Optimizer.UI.Risk.Risky}" />
                            </Grid>
                        </ComboBoxItem>
                    </ComboBox>

                    <!--  Sort By  -->
                    <ComboBox
                        SelectedIndex="{Binding ViewModel.SelectedSortByIndex}"
                        ToolTip="{ext:Loc Common.SortBy}"
                        ToolTipService.BetweenShowDelay="160"
                        ToolTipService.Placement="Top">
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="ArrowSort24" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Left">
                                    <Run Text="{ext:Loc Common.SortBy.RiskAndStatus}" />
                                </TextBlock>
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="TextSortAscending24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Name}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="Shield24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Risk}" />
                            </Grid>
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto Auto">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    Symbol="ToggleRight24" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Text="{ext:Loc Common.SortBy.Status}" />
                            </Grid>
                        </ComboBoxItem>
                    </ComboBox>

                    <ui:ToggleSwitch
                        Margin="0,0,0,0"
                        VerticalAlignment="Stretch"
                        IsChecked="{Binding ViewModel.HideApplied}"
                        Visibility="{Binding ViewModel.HasAppliedOptimizations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{ext:Loc Optimizer.Menu.HideApplied}" />
                        </StackPanel>
                    </ui:ToggleSwitch>
                </WrapPanel>
            </Border>

            <!--  No search results  -->
            <controls:EmptyStateView
                Grid.Row="1"
                Description="{ext:Loc Bloatware.Search.NoResults}"
                Symbol="SearchInfo24"
                Visibility="{Binding ViewModel.Optimizations.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

            <!--  Optimization Cards  -->
            <ui:VirtualizingItemsControl
                Grid.Row="1"
                ItemsSource="{Binding ViewModel.Optimizations}"
                VirtualizingPanel.CacheLength="1"
                VirtualizingPanel.CacheLengthUnit="Page"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                Visibility="{Binding ViewModel.Optimizations.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                <ui:VirtualizingItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                            <!--yeah -12 because <Setter Property="Margin" Value="0,0,12,12" /> -->
                            <ItemsPresenter Margin="0,0,-12,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ui:VirtualizingItemsControl.Template>
                <ui:VirtualizingItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ui:VirtualizingItemsControl.ItemsPanel>
                <ui:VirtualizingItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,12,6" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ui:VirtualizingItemsControl.ItemContainerStyle>

                <ui:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type optimization:BaseOptimization}">
                        <Border
                            Padding="16,10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusSmall}">
                            <Grid>
                                <!--  Unsupported compatibility state  -->
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Visibility="{Binding IsConditionBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Warning24" />
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="Subtitle"
                                            Text="{ext:Loc Optimizer.Condition.BlockedTitle}" />
                                    </StackPanel>
                                    <ui:TextBlock
                                        Grid.Row="1"
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                        Text="{Binding Id}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <ui:TextBlock
                                        Grid.Row="2"
                                        FontTypography="Subtitle"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding Id}" />

                                    <Border
                                        Grid.Row="3"
                                        Margin="0,12,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Symbol="Warning24" />
                                                <ui:TextBlock
                                                    VerticalAlignment="Center"
                                                    FontTypography="Caption"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="{ext:Loc Optimizer.Condition.FailedTitle}" />
                                            </StackPanel>
                                            <ui:TextBlock
                                                Margin="0,6,0,0"
                                                FontTypography="BodyStrong"
                                                Text="{Binding ConditionResult.Title}"
                                                TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Margin="0,2,0,0"
                                                FontTypography="Body"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ConditionResult.Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel
                                        Grid.Row="4"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.ViewModel.HideConditionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="{ext:Loc Optimizer.Condition.Hide}"
                                            Cursor="Hand"
                                            ToolTip="{ext:Loc Optimizer.Condition.Hide.Tooltip}" />
                                        <Border
                                            Cursor="Help"
                                            ToolTip="{ext:Loc Optimizer.Condition.WhatIsThis.Tooltip}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.Placement="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,4,0" Symbol="QuestionCircle24" />
                                                <ui:TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{ext:Loc Optimizer.Condition.WhatIsThis}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!--  Normal state: one row. Name and what it does on the left, risk and state in the
                                      middle, the switch on the right (redesign, 19/11/2026).  -->
                                <Grid ColumnDefinitions="*,Auto,Auto" Visibility="{Binding IsConditionBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ui:TextBlock
                                            FontTypography="BodyStrong"
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding Id}" />
                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ShortDescription}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <WrapPanel
                                        Grid.Column="1"
                                        MaxWidth="360"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <controls:RiskBadge
                                            Margin="0,2,6,2"
                                            Risk="{Binding Risk}"
                                            RiskVisual="{Binding RiskVisual}" />
                                        <controls:StateBadge
                                            Margin="0,2,6,2"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Icon="CheckmarkCircle24"
                                            IconBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                            Text="{ext:Loc Optimizer.UI.State.AlreadyOptimal}"
                                            ToolTip="{ext:Loc Optimizer.UI.State.AlreadyOptimal.Tooltip}"
                                            Visibility="{Binding State.IsAlreadyOptimal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <controls:StateBadge
                                            Margin="0,2,6,2"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Icon="CheckmarkCircle24"
                                            IconBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                            Text="{Binding State.RelativeTime}"
                                            ToolTip="{Binding State.AppliedTooltip}"
                                            Visibility="{Binding State.AppliedAt, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <!--  Done and not reversible (ResetBase): said even with no revert data.  -->
                                        <controls:StateBadge
                                            Margin="0,2,6,2"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Icon="LockClosed24"
                                            Text="{Binding State.DoneIrreversibleText}"
                                            Visibility="{Binding State.DoneIrreversibleText, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </WrapPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:ToggleSwitch
                                            Command="{Binding DataContext.ViewModel.ToggleOptimizationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            IsChecked="{Binding State.IsApplied, Mode=TwoWay}"
                                            IsEnabled="{Binding DataContext.ViewModel.IsProcessing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                                        <ui:Button
                                            Command="{Binding DataContext.ViewModel.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Icon="{ui:SymbolIcon MoreVertical24}"
                                            Style="{StaticResource TransparentButtonStyle}"
                                            ToolTip="{ext:Loc Optimizer.Menu.Details}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ui:VirtualizingItemsControl.ItemTemplate>
            </ui:VirtualizingItemsControl>
        </Grid>

        <!--  Loading Indicator  -->
        <controls:LoadingStateOverlay
            IsLoading="{Binding ViewModel.IsLoading}"
            Subtitle="{ext:Loc Optimizations.Loading.Hint}"
            Title="{ext:Loc Optimizations.Loading}" />
    </Grid>
</Page>

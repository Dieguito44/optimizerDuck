<Page
    x:Class="optimizerDuck.UI.Pages.DiagnosticPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DiagnosticPage"
    d:DataContext="{d:DesignInstance local:DiagnosticPage}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!--  Header  -->
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource PageHeaderGridStyle}">
            <Border Style="{StaticResource PageIconTileStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="Stethoscope24" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Diagnostic.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Diagnostic.Header.Description}" />
            </StackPanel>
        </Grid>

        <!--  Consent reminder (plan section 9, Law 1581 of 2012)  -->
        <ui:InfoBar
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="True"
            Message="{ext:Loc Diagnostic.Consent}"
            Severity="Informational" />

        <!--  Toolbar  -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarSurfaceStyle}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ViewModel.RunDiagnosticCommand}"
                        Content="{ext:Loc Diagnostic.Button.Run}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Stethoscope24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{ext:Loc Diagnostic.Button.Cancel}"
                        Cursor="Hand"
                        Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Command="{Binding ViewModel.GoToSessionCommand}"
                    Content="{ext:Loc Diagnostic.Button.ToSession}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon ArrowRight24}"
                    ToolTip="{ext:Loc Diagnostic.Button.ToSession.Tooltip}" />
            </Grid>
        </Border>

        <!--  Running  -->
        <controls:LoadingStateOverlay
            Grid.Row="3"
            IsLoading="{Binding ViewModel.IsRunning}"
            Subtitle="{ext:Loc Diagnostic.Running.Subtitle}"
            Title="{ext:Loc Diagnostic.Running}" />

        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <!--  CPU temperature (phase 6B): PawnIO is installed only for the measurement  -->
                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Temperature.Title}" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Temperature.Help}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding ViewModel.Temperature.MeasureCommand}"
                                Content="{ext:Loc Temperature.Button}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon Temperature24}" />
                            <ui:ProgressRing
                                Width="20"
                                Height="20"
                                Margin="12,0,0,0"
                                IsIndeterminate="True"
                                Visibility="{Binding ViewModel.Temperature.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            Text="{Binding ViewModel.Temperature.StatusText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Error  -->
                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding ViewModel.HasError}"
                    Message="{Binding ViewModel.ErrorText}"
                    Severity="Error" />

                <StackPanel Visibility="{Binding ViewModel.HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!--  Score  -->
                    <Border
                        Margin="0,0,0,8"
                        Padding="20,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ZentraBrandGradientBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource CornerRadiusLarge}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Grid
                                Width="88"
                                Height="88"
                                Margin="0,0,20,0">
                                <Ellipse Stroke="{DynamicResource ZentraStrokeBrush}" StrokeThickness="7" />
                                <ui:ProgressRing
                                    Width="88"
                                    Height="88"
                                    Foreground="{Binding ViewModel.ScoreBrush}"
                                    IsIndeterminate="False"
                                    Progress="{Binding ViewModel.Score}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ViewModel.Score}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Subtitle" Text="{ext:Loc Diagnostic.Score.Title}" />
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding ViewModel.CoverageText}" />
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding ViewModel.CapturedText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Findings  -->
                    <ui:TextBlock
                        Margin="0,16,0,8"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{ext:Loc Diagnostic.Findings.Header}" />
                    <ui:TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{ext:Loc Diagnostic.Findings.None}"
                        Visibility="{Binding ViewModel.HasNoFindings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSurfaceStyle}">
                                    <!--  The stripe needs its width plus the gap: a 4 px column with a 12 px margin left nothing to paint.  -->
                                    <Grid ColumnDefinitions="16,*">
                                        <Border
                                            Width="4"
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Left"
                                            Background="{Binding SeverityBrush}"
                                            CornerRadius="2" />
                                        <StackPanel Grid.Column="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <ui:TextBlock
                                                    FontTypography="BodyStrong"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border
                                                        Margin="8,0,0,0"
                                                        Padding="8,2"
                                                        Background="{Binding SeverityTintBrush}"
                                                        BorderBrush="{Binding SeverityBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding SeverityBrush}"
                                                            Text="{Binding SeverityText}" />
                                                    </Border>
                                                    <ui:TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextStyle}"
                                                        Text="{Binding PointsText}" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:TextBlock
                                                Margin="0,6,0,0"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Margin="0,8,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding EvidenceText}" />
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:TextBlock FontTypography="Caption" Text="{ext:Loc Diagnostic.Actions}" />
                                                <ui:TextBlock
                                                    FontTypography="Caption"
                                                    Text="{Binding ActionsText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Not measurable  -->
                    <StackPanel Visibility="{Binding ViewModel.HasNotMeasured, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:TextBlock
                            Margin="0,16,0,2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{ext:Loc Diagnostic.NotMeasurable.Header}" />
                        <ui:TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Diagnostic.NotMeasurable.Description}" />
                        <ItemsControl ItemsSource="{Binding ViewModel.NotMeasured}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardSurfaceStyle}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <ui:TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Reason}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

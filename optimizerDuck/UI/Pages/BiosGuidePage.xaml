<Page
    x:Class="optimizerDuck.UI.Pages.BiosGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="BiosGuidePage"
    d:DataContext="{d:DesignInstance local:BiosGuidePage}"
    d:DesignHeight="800"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource PageHeaderGridStyle}">
            <Border Style="{StaticResource PageIconTileStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="DeveloperBoard24" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc BiosGuide.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc BiosGuide.Header.Description}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{ext:Loc BiosGuide.Warning}"
                    Severity="Warning" />

                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ViewModel.BoardText}" TextWrapping="Wrap" />
                        <ui:TextBlock Margin="0,4,0,0" Text="{Binding ViewModel.MatchText}" TextWrapping="Wrap" />
                        <ui:TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ViewModel.HasGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="{ext:Loc BiosGuide.Source}" />
                            <Run Text="{Binding ViewModel.Guide.ManualUrl, Mode=OneWay}" />
                            <Run Text="(" /><Run Text="{Binding ViewModel.Guide.ManualDate, Mode=OneWay}" /><Run Text=")" />
                        </ui:TextBlock>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding ViewModel.Guide.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardSurfaceStyle}">
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <ui:TextBlock Margin="0,4,0,0" Text="{Binding Body}" TextWrapping="Wrap" />
                                    <ui:TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{Binding ManualPage, StringFormat='Manual, p. {0}'}"
                                        Visibility="{Binding IsDocumented, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

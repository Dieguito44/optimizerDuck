<Page
    x:Class="optimizerDuck.UI.Pages.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:local="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SessionPage"
    d:DataContext="{d:DesignInstance local:SessionPage}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    Style="{StaticResource PageRootStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource PageHeaderGridStyle}">
            <Border Style="{StaticResource PageIconTileStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="ClipboardTaskListLtr24" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleStyle}" Text="{ext:Loc Session.Header.Title}" />
                <ui:TextBlock Style="{StaticResource PageDescriptionStyle}" Text="{ext:Loc Session.Header.Description}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <!--  Zentra runs as another administrator: user settings go to the client's account (plan F2-05).  -->
                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding ViewModel.IsUserRedirected, Mode=OneWay}"
                    Message="{ext:Loc Session.UserRedirect}"
                    Severity="Informational" />

                <!--  Client label (local only)  -->
                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="18" Foreground="{DynamicResource ZentraBrandBrush}" Symbol="Person24" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Session.Client.Title}" />
                        </StackPanel>
                        <ui:TextBox
                            Margin="0,6,0,4"
                            IsEnabled="{Binding ViewModel.IsIdle}"
                            PlaceholderText="{ext:Loc Session.Client.Placeholder}"
                            Text="{Binding ViewModel.ClientLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc Session.Client.Help}" />
                    </StackPanel>
                </Border>

                <!--  Steps: the order of the service, numbered. The profile card below shows step 2 in detail.  -->
                <UniformGrid Margin="0,0,0,8" Columns="4">
                    <Border Margin="0,0,8,0" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Style="{StaticResource StepBadgeTextStyle}" Text="1" />
                                </Border>
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Text="{ext:Loc Session.Step.Before}" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding ViewModel.MeasureBeforeCommand}"
                                Content="{ext:Loc Session.Button.Before}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon Timer24}" />
                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ViewModel.HasBefore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:SymbolIcon Margin="0,0,5,0" FontSize="14" Foreground="{DynamicResource ZentraGoodBrush}" Symbol="CheckmarkCircle24" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource ZentraGoodBrush}" Text="{ext:Loc Session.Step.Done.Chip}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Style="{StaticResource StepBadgeTextStyle}" Text="2" />
                                </Border>
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Text="{ext:Loc Session.Step.Profile}" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ViewModel.Profile.ApplyCommand}"
                                Content="{ext:Loc Profile.Button.Apply}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Style="{StaticResource StepBadgeTextStyle}" Text="3" />
                                </Border>
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Text="{ext:Loc Session.Step.After}" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ViewModel.MeasureAfterCommand}"
                                Content="{ext:Loc Session.Button.After}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ViewModel.HasAfter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:SymbolIcon Margin="0,0,5,0" FontSize="14" Foreground="{DynamicResource ZentraGoodBrush}" Symbol="CheckmarkCircle24" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource ZentraGoodBrush}" Text="{ext:Loc Session.Step.Done.Chip}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0" Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Style="{StaticResource StepBadgeTextStyle}" Text="4" />
                                </Border>
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    Text="{ext:Loc Session.Step.Report}" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ViewModel.GeneratePdfCommand}"
                                Content="{ext:Loc Session.Button.Pdf}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon DocumentPdf24}" />
                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ViewModel.HasPdf, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:SymbolIcon Margin="0,0,5,0" FontSize="14" Foreground="{DynamicResource ZentraGoodBrush}" Symbol="CheckmarkCircle24" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource ZentraGoodBrush}" Text="{ext:Loc Session.Step.Done.Chip}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <WrapPanel Margin="0,0,0,4" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,2,8,2"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.OpenFolderCommand}"
                        Content="{ext:Loc Session.Button.Folder}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <!--  Plan of improvements F3-06: installed programs and Windows activation, read only.  -->
                    <ui:Button
                        Margin="0,2,8,2"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.ExportInventoryCommand}"
                        Content="{ext:Loc Inventory.Button}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon AppsList24}" />
                    <ui:Button
                        Margin="0,2,8,2"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.NewSessionCommand}"
                        Content="{ext:Loc Session.Button.New}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button
                        Margin="0,2,8,2"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{ext:Loc Session.Button.Cancel}"
                        Cursor="Hand"
                        Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>

                <ui:TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{ext:Loc Session.Steps.Help}" />

                <!--  Progress  -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ProgressRing Width="28" Height="28" HorizontalAlignment="Left" IsIndeterminate="True" />
                </StackPanel>
                <ui:TextBlock
                    Margin="0,0,0,12"
                    Text="{Binding ViewModel.StatusText}"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource ZentraCriticalBrush}"
                    Text="{Binding ViewModel.ErrorText}"
                    TextWrapping="Wrap" />

                <!--  Scores and metrics  -->
                <StackPanel Visibility="{Binding ViewModel.HasMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,32,0">
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc Session.Score.Before}" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ViewModel.ScoreBeforeText}" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource CaptionTextStyle}" Text="{ext:Loc Session.Score.After}" />
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ZentraBrandBrush}"
                                    Text="{Binding ViewModel.ScoreAfterText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSurfaceStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="3*,2*,2*,2*">
                                <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Report.Col.Metric}" />
                                <ui:TextBlock Grid.Column="1" FontTypography="BodyStrong" Text="{ext:Loc Report.Col.Before}" />
                                <ui:TextBlock Grid.Column="2" FontTypography="BodyStrong" Text="{ext:Loc Report.Col.After}" />
                                <ui:TextBlock Grid.Column="3" FontTypography="BodyStrong" Text="{ext:Loc Report.Col.Change}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ViewModel.Metrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" ColumnDefinitions="3*,2*,2*,2*">
                                            <ui:TextBlock Text="{Binding Name}" />
                                            <ui:TextBlock Grid.Column="1" Text="{Binding Before}" />
                                            <ui:TextBlock Grid.Column="2" Text="{Binding After}" />
                                            <ui:TextBlock Grid.Column="3" Text="{Binding Difference}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  "Servicio estándar" profile (phase 6): between the "before" and "after" measurements.  -->
                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource StepBadgeStyle}">
                                <TextBlock Style="{StaticResource StepBadgeTextStyle}" Text="2" />
                            </Border>
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                FontTypography="BodyStrong"
                                Text="{ext:Loc Profile.Title}" />
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0,6,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Profile.Help}"
                            TextWrapping="Wrap" />
                        <!--  Plan of improvements F3-01: which preset the buttons apply.  -->
                        <ui:TextBlock
                            Margin="0,0,0,6"
                            FontTypography="Body"
                            Text="{Binding ViewModel.Profile.PresetText}"
                            TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.Profile.RevertCommand}"
                                Content="{ext:Loc Profile.Button.Revert}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon ArrowUndo24}" />
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.Profile.ImportPresetCommand}"
                                Content="{ext:Loc Preset.Button.Import}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.Profile.ExportPresetCommand}"
                                Content="{ext:Loc Preset.Button.Export}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon Save24}" />
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.Profile.UseStandardPresetCommand}"
                                Content="{ext:Loc Preset.Button.Standard}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                Visibility="{Binding ViewModel.Profile.IsCustomPreset, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                        <ui:ProgressRing
                            Width="22"
                            Height="22"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.Profile.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            Text="{Binding ViewModel.Profile.StatusText}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Foreground="{DynamicResource ZentraCriticalBrush}"
                            Text="{Binding ViewModel.Profile.ErrorText}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Profile.Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:TextBlock Foreground="{DynamicResource ZentraHighBrush}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Plan of improvements F3-05: diagnosis-only follow-up at 7 and 30 days.  -->
                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="18" Foreground="{DynamicResource ZentraBrandBrush}" Symbol="CalendarClock24" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc FollowUp.Title}" />
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc FollowUp.Help}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock Margin="0,0,0,6" Text="{Binding ViewModel.FollowUp.StatusText}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.FollowUp.ScheduleCommand}"
                                Content="{ext:Loc FollowUp.Button.Schedule}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon CalendarClock24}" />
                            <ui:Button
                                Margin="0,2,8,2"
                                Command="{Binding ViewModel.FollowUp.RemoveCommand}"
                                Content="{ext:Loc FollowUp.Button.Remove}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon CalendarCancel24}" />
                            <ui:Button
                                Margin="0,2,8,2"
                                Appearance="Transparent"
                                Command="{Binding ViewModel.FollowUp.OpenResultsCommand}"
                                Content="{ext:Loc FollowUp.Button.Results}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Visibility="{Binding ViewModel.FollowUp.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                        <ui:TextBlock
                            Foreground="{DynamicResource ZentraCriticalBrush}"
                            Text="{Binding ViewModel.FollowUp.ErrorText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  "Modo juego avanzado" (phase 7): visible while Memory Integrity is off, with the way back.  -->
                <Border Style="{StaticResource CardSurfaceStyle}" Visibility="{Binding ViewModel.GameMode.IsApplied, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Foreground="{DynamicResource ZentraHighBrush}" Text="{ext:Loc GameMode.Title}" />
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc GameMode.Help}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,2,8,2"
                            Appearance="Primary"
                            Command="{Binding ViewModel.GameMode.TurnProtectionOnCommand}"
                            Content="{ext:Loc GameMode.Button.Revert}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                        <ui:TextBlock
                            Margin="0,6,0,0"
                            Text="{Binding ViewModel.GameMode.StatusText}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Foreground="{DynamicResource ZentraCriticalBrush}"
                            Text="{Binding ViewModel.GameMode.ErrorText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Report with AI (phase 5). The key is read from a plain WPF PasswordBox, never bound.  -->
                <Border Style="{StaticResource CardSurfaceStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="18" Foreground="{DynamicResource ZentraBrandBrush}" Symbol="Sparkle24" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{ext:Loc Session.Ai.Title}" />
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Session.Ai.Help}"
                            TextWrapping="Wrap" />

                        <!--  Plan F1-07: the client's authorization (Ley 1581). Without it nothing goes to the AI.  -->
                        <CheckBox Margin="0,0,0,8" IsChecked="{Binding ViewModel.AiConsentGiven}" IsEnabled="{Binding ViewModel.IsIdle}">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{ext:Loc Session.Ai.Consent.Text}"
                                TextWrapping="Wrap" />
                        </CheckBox>

                        <!--  Plan F1-08: on a client's PC there is no key box; the report goes through files.  -->
                        <StackPanel Visibility="{Binding ViewModel.IsClientPc, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{ext:Loc Session.Ai.ClientHelp}"
                                TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Command="{Binding ViewModel.ExportAiRequestCommand}"
                                    Content="{ext:Loc Session.Ai.Button.Export}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon ArrowExportUp24}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Command="{Binding ViewModel.ImportAiReportCommand}"
                                    Content="{ext:Loc Session.Ai.Button.Import}"
                                    Cursor="Hand"
                                    Icon="{ui:SymbolIcon ArrowImport24}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ViewModel.IsTechnicianPc, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <PasswordBox
                                x:Name="KeyBox"
                                MinHeight="32"
                                VerticalContentAlignment="Center"
                                IsEnabled="{Binding ViewModel.IsIdle}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding ViewModel.UseKeyCommand}"
                                CommandParameter="{Binding ElementName=KeyBox}"
                                Content="{ext:Loc Session.Ai.Button.UseKey}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon Key24}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding ViewModel.ForgetKeyCommand}"
                                Content="{ext:Loc Session.Ai.Button.Forget}"
                                Cursor="Hand"
                                Icon="{ui:SymbolIcon Delete24}"
                                Visibility="{Binding ViewModel.HasKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <CheckBox
                            Margin="0,6,0,0"
                            Content="{ext:Loc Session.Ai.Remember}"
                            IsChecked="{Binding ViewModel.RememberKey}"
                            Visibility="{Binding ViewModel.CanRememberKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{ext:Loc Session.Ai.RememberWarning}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ViewModel.CanRememberKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock Margin="0,6,0,0" Text="{Binding ViewModel.KeyStatusText}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource ZentraCriticalBrush}"
                            Text="{Binding ViewModel.KeyErrorText}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,10,0,0"
                            Command="{Binding ViewModel.WriteFromRequestCommand}"
                            Content="{ext:Loc Session.Ai.Button.FromFile}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon DocumentArrowRight24}" />
                        </StackPanel>
                        <ui:Button
                            Margin="0,10,0,0"
                            Appearance="Primary"
                            Command="{Binding ViewModel.WriteReportCommand}"
                            Content="{ext:Loc Session.Ai.Button.Write}"
                            Cursor="Hand"
                            Icon="{ui:SymbolIcon Sparkle24}" />

                        <!--  Preview of the written report  -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ViewModel.HasWritten, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="{Binding ViewModel.WrittenSummary}" TextWrapping="Wrap" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ViewModel.WrittenPriorities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                TextWrapping="Wrap">
                                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Who, Mode=OneWay}" />
                                            </TextBlock>
                                            <ui:TextBlock Margin="14,0,0,0" Text="{Binding Explanation}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ViewModel.WrittenWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:TextBlock Margin="0,2" Foreground="{DynamicResource ZentraHighBrush}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ViewModel.WrittenSource}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

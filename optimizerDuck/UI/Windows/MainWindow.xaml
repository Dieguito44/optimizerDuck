<ui:FluentWindow
    x:Class="optimizerDuck.UI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="clr-namespace:optimizerDuck.Services.Configuration"
    xmlns:controls="clr-namespace:optimizerDuck.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:optimizerDuck.Common.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:optimizerDuck.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:optimizerDuck.UI.ViewModels.Windows"
    xmlns:windows="clr-namespace:optimizerDuck.UI.Windows"
    Title="Zentra"
    Width="1350"
    Height="800"
    MinWidth="900"
    MinHeight="500"
    d:DataContext="{d:DesignInstance viewmodels:MainWindowViewModel}"
    ui:Design.Background="Black"
    ui:Design.Foreground="White"
    ExtendsContentIntoTitleBar="True"
    SnapsToDevicePixels="True"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid FlowDirection="{Binding Direction, Source={x:Static config:Loc.Instance}}">
        <!--  Redesign (19/11/2026): title, grouped tabs, the page, and the activity log.  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Padding="16,6,16,8"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel x:Name="NavBar" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,2">
                        <TextBlock Style="{StaticResource NavGroupLabelStyle}" Text="{extensions:Loc Nav.Group.Service}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:DashboardPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Home24" /><TextBlock Text="{extensions:Loc Nav.Dashboard}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:DiagnosticPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Stethoscope24" /><TextBlock Text="{extensions:Loc Nav.Diagnostic}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:SessionPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="ClipboardTaskListLtr24" /><TextBlock Text="{extensions:Loc Nav.Session}" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,2">
                        <TextBlock Style="{StaticResource NavGroupLabelStyle}" Text="{extensions:Loc Nav.Group.Fix}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:OptimizePage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Flash24" /><TextBlock Text="{extensions:Loc Nav.Optimize}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:RepairPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="WrenchScrewdriver24" /><TextBlock Text="{extensions:Loc Nav.Repair}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:DiskCleanupPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="HardDrive20" /><TextBlock Text="{extensions:Loc Nav.DiskCleanup}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:BloatwarePage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Delete24" /><TextBlock Text="{extensions:Loc Nav.Bloatware}" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,2">
                        <TextBlock Style="{StaticResource NavGroupLabelStyle}" Text="{extensions:Loc Nav.Group.Tools}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:SoftwarePage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="AppsAddIn24" /><TextBlock Text="{extensions:Loc Nav.Software}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:StartupManagerPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Power24" /><TextBlock Text="{extensions:Loc Nav.StartupManager}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:ScheduledTasksPage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="TabDesktopArrowClockwise24" /><TextBlock Text="{extensions:Loc Nav.ScheduledTasks}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:CustomizePage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="Sparkle24" /><TextBlock Text="{extensions:Loc Nav.Customize}" /></StackPanel>
                            </RadioButton>
                            <RadioButton Click="OnNavClick" Style="{StaticResource NavPillStyle}" Tag="{x:Type pages:BiosGuidePage}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,5,0" FontSize="15" Symbol="DeveloperBoard24" /><TextBlock Text="{extensions:Loc Nav.BiosGuide}" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <RadioButton
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Click="OnNavClick"
                    Style="{StaticResource NavPillStyle}"
                    Tag="{x:Type pages:SettingsPage}"
                    ToolTip="{extensions:Loc Sidebar.Settings}">
                    <ui:SymbolIcon Symbol="Settings24" />
                </RadioButton>
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            Margin="0"
            Padding="0"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="False"
            IsPaneToggleVisible="False"
            IsTopSeparatorVisible="False"
            PaneDisplayMode="Top"
            Style="{StaticResource HiddenPaneNavigationViewStyle}">
            <ui:NavigationView.MenuItems>
                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Dashboard}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Diagnostic}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Stethoscope24}"
                    TargetPageType="{x:Type pages:DiagnosticPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Session}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon ClipboardTaskListLtr24}"
                    TargetPageType="{x:Type pages:SessionPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Repair}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                    TargetPageType="{x:Type pages:RepairPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Software}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon AppsAddIn24}"
                    TargetPageType="{x:Type pages:SoftwarePage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.BiosGuide}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon DeveloperBoard24}"
                    TargetPageType="{x:Type pages:BiosGuidePage}" />

                <ui:NavigationViewItemSeparator Margin="0,2,0,2" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Optimize}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Flash24}"
                    TargetPageType="{x:Type pages:OptimizePage}" />

                <controls:FilledNavigationViewItem
                    x:Name="CustomizeMenuItem"
                    Content="{extensions:Loc Sidebar.Customize}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Sparkle24}"
                    TargetPageType="{x:Type pages:CustomizePage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Bloatware}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Delete24}"
                    TargetPageType="{x:Type pages:BloatwarePage}" />

                <ui:NavigationViewItemSeparator Margin="0,2,0,2" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.StartupManager}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Power24}"
                    TargetPageType="{x:Type pages:StartupManagerPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.ScheduledTasks}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon TabDesktopArrowClockwise24}"
                    TargetPageType="{x:Type pages:ScheduledTasksPage}" />

                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.DiskCleanup}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon HardDrive20}"
                    TargetPageType="{x:Type pages:DiskCleanupPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItemSeparator Margin="0,2,0,2" />
                <controls:FilledNavigationViewItem
                    Content="{extensions:Loc Sidebar.Settings}"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:ImageIcon
                        Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/Resources/Images/Zentra.png" />
                    <ui:TextBlock
                        x:Name="AppTitleText"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="Zentra" />
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ZentraBrandMutedBrush}"
                        CornerRadius="4">
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource ZentraBrandBrush}"
                            Text="{Binding Version, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!--  Bitácora: the last line always shows; click it to see the list.  -->
        <Border
            Grid.Row="3"
            Padding="16,0,16,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid
                    x:Name="LogHeader"
                    Height="30"
                    Background="Transparent"
                    ColumnDefinitions="Auto,*,Auto"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnLogHeaderClick">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            FontSize="14"
                            Symbol="TextBulletListLtr24" />
                        <TextBlock FontWeight="SemiBold" Text="{extensions:Loc Activity.Title}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LogLastLine"
                        Grid.Column="1"
                        Margin="14,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource LogFontFamily}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="LogToggleText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{extensions:Loc Activity.Show}" />
                </Grid>
                <ScrollViewer
                    x:Name="LogScroll"
                    Height="120"
                    Margin="0,0,0,8"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="{StaticResource LogFontFamily}"
                                    FontSize="12"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Good">
                                                    <Setter Property="Foreground" Value="{DynamicResource ZentraGoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource ZentraWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource ZentraCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TimeText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogPresenter" Grid.RowSpan="4" />
    </Grid>
</ui:FluentWindow>

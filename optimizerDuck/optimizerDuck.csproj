<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <!-- CET shadow stacks are enabled by default for .NET 9+ apphosts/singlefilehosts,
             but the CoreCLR requires QueueUserAPC2 (Windows 11 build 22000+ / Server 2022
             only - it does not exist on Windows 10) whenever shadow stacks are active, so
             every published build fails to start on Windows 10 with 0x80131506 ("Your
             Windows doesn't fully support CET"). Disable CETCompat to keep the Windows 10
             support the README promises. See #50. -->
        <CETCompat>false</CETCompat>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Zentra is a fork of optimizerDuck (GPL v3). The executable is Zentra.exe; the C#
             namespaces stay optimizerDuck.* so upstream fixes can still be merged. -->
        <AssemblyName>Zentra</AssemblyName>
        <RootNamespace>optimizerDuck</RootNamespace>
        <Authors>Dieguito44; fatDuck (optimizerDuck)</Authors>
        <ApplicationIcon>Logo.ico</ApplicationIcon>
        <Company>Dieguito44</Company>
        <FileVersion>1.1.2</FileVersion>
        <Version>1.1.2</Version>
        <Product>Zentra</Product>
        <Copyright>Copyright (C) 2026 Dieguito44. Based on optimizerDuck, Copyright (C) 2025-2026 fatDuck. GPL v3.</Copyright>
        <AssemblyTitle>Zentra</AssemblyTitle>
        <AssemblyDescription>Windows PC diagnosis, repair and optimization. Based on optimizerDuck.</AssemblyDescription>
        <NeutralLanguage>en-US</NeutralLanguage>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- The gate: a warning fails the build, and the promoted style rules run inside it. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <Page Update="UI\Windows\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\Pages\Optimize\Categories\OptimizationPage.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="UI\Pages\Features\FeaturesPage.xaml">
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="QuestPDF" Version="2026.9.2" />
        <PackageReference Include="Serilog" Version="4.4.1-dependabot-02442" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
        <PackageReference Include="System.Management.Automation" Version="7.6.99-rebuild.99" />
        <PackageReference Include="TaskScheduler" Version="2.12.2" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="optimizerDuck.Test" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Languages\Translations.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Translations.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Embedded\Icons\blank.ico" />
        <EmbeddedResource Include="Resources\Embedded\PowerPlans\optimizerDuck.pow" />
        <!-- Zentra diagnostic reference tables (ram_kits, ssd_tbw, bios_latest). -->
        <EmbeddedResource Include="Resources\Embedded\Diagnostics\*.json" />
    </ItemGroup>

    <!-- DiskSpd built from Microsoft's MIT source (see Resources\Tools\DiskSpd\BUILD.txt). -->
    <ItemGroup>
        <Content
            Include="Resources\Tools\DiskSpd\diskspd.exe"
            Link="Tools\diskspd.exe"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Resources\Tools\DiskSpd\LICENSE.txt"
            Link="Tools\diskspd.LICENSE.txt"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <!-- smartctl from smartmontools 7.5, GPL-2.0 (see Resources\Tools\smartmontools\SOURCE.txt). -->
    <ItemGroup>
        <Content
            Include="Resources\Tools\smartmontools\smartctl.exe"
            Link="Tools\smartctl.exe"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Resources\Tools\smartmontools\LICENSE.txt"
            Link="Tools\smartctl.LICENSE.txt"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Resources\Tools\smartmontools\SOURCE.txt"
            Link="Tools\smartctl.SOURCE.txt"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Images\Duck.png" />
        <Resource Include="Resources\Images\Zentra.png" />
        <Resource Include="Resources\Images\GitHubLogoBlack.png" />
        <Resource Include="Resources\Images\GitHubLogoWhite.png" />
        <Resource Include="Resources\Images\DiscordLogo.png" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Languages\Translations.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Translations.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <!--
        The Claude API key, only in "dotnet publish" on Diego's PC (20/11/2026, see
        Services/Ai/EmbeddedApiKey.cs). It comes from a DPAPI file outside the repository and is
        written masked under obj/. GitHub builds, tests and plain builds carry no key.
    -->
    <PropertyGroup>
        <ZentraKeyFile Condition="'$(ZentraKeyFile)' == ''">$(MSBuildProjectDirectory)\..\..\zentra-secretos\clave-api.dpapi</ZentraKeyFile>
    </PropertyGroup>
    <Target
        Name="ZentraEmbedApiKey"
        BeforeTargets="CoreCompile"
        Condition="'$(_IsPublishing)' == 'true' And '$(GITHUB_ACTIONS)' != 'true' And Exists('$(ZentraKeyFile)')">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\embed-api-key.ps1&quot; -KeyFile &quot;$(ZentraKeyFile)&quot; -OutFile &quot;$(IntermediateOutputPath)EmbeddedApiKey.g.cs&quot;" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)EmbeddedApiKey.g.cs" />
        </ItemGroup>
    </Target>
</Project>
